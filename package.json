{
  "name": "@call-intelligence-labs/db",
  "version": "1.1.2",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Call-Intelligence-Labs/call-intelligence-db.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run build",
    "publish:pkg": "npm publish"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0",
    "postgres": ">=3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
